# Streamlit Cloud の「Secrets」にこの内容をコピーして設定してください
# （このファイルは例です。実際の secrets.toml は Git にコミットしないこと）

# アプリアクセスパスワード
password = "your-password-here"

# Gmail SMTP設定
smtp_server = "smtp.gmail.com"
smtp_port = 587
smtp_user = "xxxx@gmail.com"
smtp_password = "xxxxxxxxxxxxxxxx"
from_address = "xxxx@gmail.com"

# 送信者情報（メール本文のフッターに使用）
差出人名 = "安田"
差出人所属 = "朝日事務所（社労士事務所）"
差出人電話 = "03-xxxx-xxxx"
